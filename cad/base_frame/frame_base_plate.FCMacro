import FreeCAD as App, Part, math
BASE_T, BASE_D, M5 = 4.0, 200.0, 5.5
D_IN, OUTER = 14.5, [60.0, 75.0]
ANGLES = [0, 120, 240]  # Dedicated 3-cell 120-degree triad
# In-place update (Option 2): edit the part in the ACTIVE document. If no document
# is open, fall back to creating one (standalone/headless use). Open the document
# that holds the old part before running this macro.
doc = App.ActiveDocument
if doc is None:
    doc = App.newDocument("BaseDisk")
b = Part.makeCylinder(BASE_D/2, BASE_T)
for a in ANGLES:
    for x in OUTER:
        r = D_IN + x; t = math.radians(a)
        b = b.cut(Part.makeCylinder(M5/2, BASE_T, App.Vector(r*math.cos(t), r*math.sin(t), 0)))
obj = doc.getObject("BaseDisk")
if obj is None:
    obj = doc.addObject("Part::Feature", "BaseDisk")
obj.Shape = b
doc.recompute()
